# CareerMitra AI -- .gitignore
# Never commit real credentials
.env

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# IDEs
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Streamlit secrets
.streamlit/secrets.toml

# Database (contains student data)
data/careermitra.db
data/*.db

# Logs
*.log
logs/

# Test artefacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
# Environment security
.env.*
!.env.example

# All database files
*.db
*.sqlite
*.sqlite3

# Private resume uploads
uploads/
.streamlit/credentials.toml